# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Both headers are required by the Timetables API — either alone returns 401.
# Get them from https://developers.deutschebahn.com: register, create an app,
# then subscribe that app to the "Timetables" product.
#
# `dbrel tt-check` verifies them and reports which header is wrong without ever
# echoing a value.

DB_CLIENT_ID=
TIMETABLES_API_KEY=

# --- optional overrides -----------------------------------------------------
# The request rate is not a fixed number and is not set here by default -- the
# live settings and how they were chosen live in src/dbrel/config.py
# (TT_RPS_FAST / TT_RPM_PENALTY / TT_PENALTY_S / TT_FETCH_WORKERS), backed by
# docs/probe-findings.md §27. Override only if you have a reason to:
# DBREL_TT_RPS_FAST=60            # requests/second, normal mode
# DBREL_TT_RPM_PENALTY=58         # requests/minute, while backed off after a 429
# DBREL_TT_PENALTY_S=180          # how long one backoff lasts
# DBREL_TT_FETCH_WORKERS=8        # concurrent connections for /plan fetching
# DBREL_DB=data/dbrel.sqlite      # database path
# DBREL_TT_PLAN_LEAD_HOURS=3      # how far ahead the /plan roller reaches
# DBREL_WEB_DEBUG=0               # 1 enables Django's debug pages
# DBREL_SECRET_KEY=               # set this if the web UI is exposed beyond localhost
# DBREL_ALLOWED_HOSTS=            # comma-separated, added to localhost

# --- dbrel collect defaults (all overridable per-run with --every/--for/etc.) --
# DBREL_STATIONS_FILE=config/ruhr_stations.toml
# DBREL_COLLECT_EVERY_S=14400     # 4h; the true ceiling is TT_LINGER_S (6h)
# DBREL_COLLECT_FOR_S=604800      # 7d; 0 = until interrupted
# DBREL_COLLECT_MAX_LOOKBACK_S=57600   # 16h; see docs/probe-findings.md §24
